# WEBMORPH Backend — Environment Configuration
# Copy this file to .env and fill in the values.

# Database
# Production: postgresql+asyncpg://user:password@localhost:5432/webmorph
# Development: sqlite+aiosqlite:///./webmorph.db
DATABASE_URL=sqlite+aiosqlite:///./webmorph.db

# Bright Data
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_COLLECTOR_ID=c_mt45ptkn297h5onaf7
BRIGHT_DATA_TARGET_URL=https://caniuse.com/css-sticky

# CLI
BDATA_CLI_PATH=bdata
BDATA_CLI_TIMEOUT_SECONDS=120
BDATA_CLI_MAX_OUTPUT_BYTES=5242880

# Application
APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=false
